#!/usr/bin/env python3
"""adb-mdns: find the port of Android "Wireless debugging" (Android 11+) via mDNS.

Wireless debugging listens on a random TLS port and announces it as _adb-tls-connect._tcp.
The adb builds shipped by Debian and Alpine have no mDNS support ("unknown host service mdns"),
and a port scan does not work either because the phone silently drops closed ports.

Usage:  adb-mdns <phone-ip> [seconds]
Prints the port and exits 0, or prints nothing and exits 1. Python standard library only.
"""
import socket
import struct
import sys
import time

SERVICE = "_adb-tls-connect._tcp.local"


def encode_name(n):
    return b"".join(bytes([len(p)]) + p.encode() for p in n.split(".")) + b"\0"


def read_name(d, i):
    """Decode a (possibly compressed) DNS name at offset i. Returns (name, offset after it)."""
    parts, jumped, end = [], False, i
    while True:
        length = d[i]
        if length == 0:
            i += 1
            break
        if length & 0xC0 == 0xC0:  # compression pointer
            if not jumped:
                end = i + 2
            i = ((length & 0x3F) << 8) | d[i + 1]
            jumped = True
            continue
        parts.append(d[i + 1:i + 1 + length].decode(errors="replace"))
        i += 1 + length
    return ".".join(parts), (end if jumped else i)


def query():
    # one PTR question, QU bit set (ask for a unicast response)
    return struct.pack("!HHHHHH", 0, 0, 1, 0, 0, 0) + encode_name(SERVICE) + struct.pack("!HH", 12, 0x8001)


def srv_records(d):
    """Yield (name, port) for every SRV record in a DNS message."""
    _, _, qd, an, ns, ar = struct.unpack("!HHHHHH", d[:12])
    i = 12
    for _ in range(qd):
        _, i = read_name(d, i)
        i += 4
    for _ in range(an + ns + ar):
        n, i = read_name(d, i)
        rtype, _, _, rdlen = struct.unpack("!HHIH", d[i:i + 10])
        i += 10
        if rtype == 33:  # SRV: priority, weight, port, target
            yield n, struct.unpack("!H", d[i + 4:i + 6])[0]
        i += rdlen


def main():
    if len(sys.argv) < 2:
        print(__doc__, file=sys.stderr)
        return 2
    ip = sys.argv[1]
    duration = float(sys.argv[2]) if len(sys.argv) > 2 else 6
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 255)
    s.bind(("", 0))
    s.settimeout(0.5)
    deadline = time.time() + duration
    next_send = 0
    while time.time() < deadline:
        if time.time() >= next_send:
            s.sendto(query(), ("224.0.0.251", 5353))
            s.sendto(query(), (ip, 5353))  # also ask the phone directly (works across some multicast filters)
            next_send = time.time() + 1.5
        try:
            d, (source, _) = s.recvfrom(9000)
        except socket.timeout:
            continue
        if source != ip:
            continue
        try:
            for n, port in srv_records(d):
                if "_adb-tls-connect" in n:
                    print(port)
                    return 0
        except Exception:
            continue
    return 1


if __name__ == "__main__":
    sys.exit(main())
